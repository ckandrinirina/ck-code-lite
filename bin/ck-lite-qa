#!/usr/bin/env bash
# ck-lite-qa — run QA commands once per code state, and never twice on the same one.
# Ported from ck-code's scripts/ck-qa.sh; self-contained, lite never depends on ck-code.
#
# Usage:
#   ck-lite-qa state
#   ck-lite-qa run <id> [--parallel] [--reuse] [--rerun] <label>=<command> [<label>=<command>…]
#   ck-lite-qa wait <id> [--end]
#   ck-lite-qa since <id> <label>
#   ck-lite-qa start <id> [--at <commit>|work] [--base <commit>|auto] [--parallel] <label>=<command>…
#   ck-lite-qa gate [<ref>] [--base <ref>|auto] [--again]
#   ck-lite-qa waive <id> "<reason>"
#   ck-lite-qa lane-free
#   ck-lite-qa docker-free <worktree-path>…
#   ck-lite-qa reap
#
# state  prints the code-state id: the git tree of the working copy, untracked
#        (non-ignored) files included, so an uncommitted change is a different state.
# run    runs each command from the current directory, output to
#        ${TMPDIR:-/tmp}/ck-lite-<id>-<label>.log, and stamps every pass with
#        (state, directory, command). --reuse reports a command already passed on that
#        exact triple as REUSED instead of running it. --parallel runs them concurrently
#        and reports every failure; the default is in order, stopping at the first one.
#        Prints one line per command, the last 40 log lines of each failure, up to 3
#        `lesson:` lines from ${CK_LESSONS:-~/.claude/ck-lessons.md} whose regex matches a failed
#        log (a fix another project found), then
#        `ck-lite-qa: PASS` (exit 0) or `ck-lite-qa: FAIL — <labels>` (exit 1).
#        The commands run detached, and run waits up to CK_LITE_QA_WAIT seconds (default 170,
#        under the 180 s after which Claude Code moves a sub-agent's Bash call to the background). A longer run prints
#        `ck-lite-qa: RUNNING` (exit 3) and keeps going. The same run started again while it
#        is going waits on it instead of starting a second copy.
#        Under the Claude Code sandbox (SANDBOX_RUNTIME=1), which kills a background process
#        with its Bash call, or with CK_QA_FOREGROUND=1, run and start stay in the foreground.
#        Every command that ran on an unchanged tree also records its last run for
#        (id, label, directory): a snapshot commit of the code state, and the full command.
# --rerun  marks each <command> as a narrowed re-run of that label's last run here: the
#        tests that failed plus those affected since the snapshot. A pass stamps the
#        recorded full command on the new state, so a later --reuse of it reports REUSED.
#        It is refused when the label has no recorded run in this directory.
# wait   waits up to CK_LITE_QA_WAIT seconds more on the run for <id> and prints its result,
#        or RUNNING again. Once it has ended, wait prints that result again.
#        --end waits without a limit, for a background Bash call of the main agent.
# start  returns at once: the commands run in the background lane (a separate checkout of
#        --at, default HEAD; `work` = the working copy as it stands), so editing goes on. A
#        command may hold {base} (the last commit that passed it, never older than --base) and
#        may start with @ (its output is the command to run, for a scope that must be computed
#        in the lane). A newer start of the same commands replaces one still queued (its
#        wait exits 4).
# gate   GREEN or NONE (exit 0), RED (1), PENDING (3) or UNCHECKED (5) for <ref>, default
#        HEAD, from the runs `start` recorded since --base (`auto`: where <ref> left the
#        trunk). --again starts what is not green.
# waive  records that the user accepted the failure of <id>'s last run.
# lane-free  removes this repository's lane.
# since  prints the snapshot commit of <label>'s last run for <id> in this directory, the
#        ref a runner's --changed flag narrows a re-run against.
# reap   stops the leftover hand-written wait loops (until/while … sleep on a QA run, a pgrep
#        or a task output file) of this Claude Code session. Orchestrators only, after every
#        agent they dispatched returned; the one way to wait on a run is `wait`.
# docker-free  removes every Docker container whose compose working dir is inside each
#        linked worktree <path>, running or not, with its own project's volumes — run
#        before a worktree is parked or removed. Refuses the main checkout.
# A run prunes this runner's logs and records older than CK_QA_KEEP_DAYS (default 7),
#        and removes the stopped Docker containers and unused volumes its commands
#        created here (CK_QA_DOCKER=0 turns that off).

set -uo pipefail

die() { echo "ck-lite-qa: ERROR — $*" >&2; exit 2; }
TMP="${TMPDIR:-/tmp}"; TMP="${TMP%/}"
STAMPS="$TMP/ck-lite-qa"
# Runs and logs are keyed by checkout as well as id: two projects building T-01 never meet.
REPO="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
REPO="$(printf '%s' "$REPO" | cksum | cut -d' ' -f1)"
RUNS="$TMP/ck-lite-qa-run/$REPO"
SELF="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")"

# The tree id of the working copy, computed in a throwaway index so the real one is never
# touched. Prints nothing outside a git repository — a state that can never be reused.
state() {
  local top idx real
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  idx="$(mktemp "$TMP/ck-lite-qa-index.XXXXXX")" || return 0
  real="$(git -C "$top" rev-parse --path-format=absolute --git-path index 2>/dev/null)"
  if [ -f "$real" ]; then cp "$real" "$idx"; else rm -f "$idx"; fi
  # tasks/PLAN.md is bookkeeping, not code, and bytecode is regenerated by every Python run:
  # neither makes a new code state, so a plan write or a test run never voids a stamp.
  ( cd "$top" || exit 0
    export GIT_INDEX_FILE="$idx"
    git add -A >/dev/null 2>&1 || exit 0
    git rm -r -q --cached --ignore-unmatch -- tasks/PLAN.md '*/tasks/PLAN.md' '*.pyc' '*/__pycache__/*' >/dev/null 2>&1
    git write-tree 2>/dev/null )
  rm -f "$idx"
}

# A commit object for tree $1, parented on HEAD so a runner's merge-base against it (jest
# --changedSince) resolves. Nothing references it; git gc drops it after the prune window.
snapshot() {
  local e="GIT_AUTHOR_NAME=ck-lite-qa GIT_AUTHOR_EMAIL=ck-lite-qa@localhost GIT_COMMITTER_NAME=ck-lite-qa GIT_COMMITTER_EMAIL=ck-lite-qa@localhost"
  if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
    env $e git commit-tree -p HEAD -m "ck-lite-qa snapshot" "$1" 2>/dev/null
  else
    env $e git commit-tree -m "ck-lite-qa snapshot" "$1" 2>/dev/null
  fi
}

last_of() { printf '%s/last-%s-%s-%s' "$STAMPS" "$REPO" "$1" "$2"; }   # id label → last-run record

# Prints line $3 (1 snapshot, 2 directory, 3 full command) of the last-run record for
# id $1 label $2, only when that run was in this directory.
last_field() {
  local f; f="$(last_of "$1" "$2")"
  [ -f "$f" ] && [ "$(sed -n 2p "$f")" = "$(pwd -P)" ] || return 1
  sed -n "$3p" "$f"
}

stamp_of() { printf '%s\n%s\n%s\n' "$1" "$(pwd -P)" "$2" | git hash-object --stdin; }

# >>> ck-cpu-slots — byte-identical in ck-code's ck-qa.sh and ck-code-lite's ck-lite-qa
# (plugin-doctor compares the two). Every run on this machine — any project, any worktree,
# either plugin — shares CPU_SLOTS slots, so three worktrees building at once queue instead
# of each starting one job per core (background lane runs queue among themselves, so a
# builder's quick run never waits for one). A throttle, not a lock: a lost race costs one extra
# concurrent run, never a wrong result. CK_QA_SLOTS=0 turns the queue off.
SLOTS_DIR="$TMP/ck-cpu-slots${CK_QA_POOL:+-$CK_QA_POOL}"   # the background lane has its own pool
NCPU="$(getconf _NPROCESSORS_ONLN 2>/dev/null)"
case "$NCPU" in ''|*[!0-9]*|0) NCPU=4 ;; esac
CPU_SLOTS="${CK_QA_SLOTS:-$(( NCPU / 8 ))}"
case "$CPU_SLOTS" in ''|*[!0-9]*) CPU_SLOTS=1 ;; esac
[ -n "${CK_QA_SLOTS:-}" ] || [ "$CPU_SLOTS" -ge 1 ] || CPU_SLOTS=1
QA_NICE="${CK_QA_NICE:-10}"
case "$QA_NICE" in ''|*[!0-9]*) QA_NICE=10 ;; esac
# The Claude Code sandbox (SANDBOX_RUNTIME=1) kills every background process when the Bash call
# that started it ends, and refuses setpriority: there a run stays in the foreground of its
# call and is not niced. CK_QA_FOREGROUND=1 keeps runs in the foreground anywhere.
qa_sandboxed() { [ "${SANDBOX_RUNTIME:-}" = 1 ]; }
qa_foreground() { qa_sandboxed || [ "${CK_QA_FOREGROUND:-}" = 1 ]; }
SLOT=""; SLOT_WAITED=0; SLOT_IDLE=0
QA_TIMEOUT="${CK_QA_TIMEOUT:-3600}"
case "$QA_TIMEOUT" in ''|*[!0-9]*) QA_TIMEOUT=3600 ;; esac
QA_OVERFLOW="${CK_QA_OVERFLOW:-30}"
case "$QA_OVERFLOW" in ''|*[!0-9]*) QA_OVERFLOW=30 ;; esac

# The 1-minute load average as a whole number, or nothing when it cannot be read.
load1() {
  local l
  l="$(sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | awk '{print $1}')"
  [ -n "$l" ] || l="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)"
  l="${l%%.*}"
  case "$l" in ''|*[!0-9]*) return 0 ;; esac
  printf '%s' "$l"
}

# Takes a free slot, waiting while every one is busy, with $1 (when given) touched while it
# waits. A slot whose holder is gone is taken back. A run nested in one that holds a slot
# (CK_QA_IN_SLOT) runs in its parent's slot, so it can never wait on itself.
slot_take() {
  local i p l t0=$SECONDS
  { [ "$CPU_SLOTS" -gt 0 ] && [ -z "${CK_QA_IN_SLOT:-}" ]; } || return 0
  mkdir -p "$SLOTS_DIR" 2>/dev/null || return 0
  while :; do
    i=1
    while [ "$i" -le "$CPU_SLOTS" ]; do
      if mkdir "$SLOTS_DIR/$i" 2>/dev/null; then
        echo $$ >"$SLOTS_DIR/$i/pid"; SLOT=$i; SLOT_WAITED=$((SECONDS - t0))
        [ -z "${1:-}" ] || rm -f "$1"
        slot_env; return 0
      fi
      p="$(cat "$SLOTS_DIR/$i/pid" 2>/dev/null)"
      # holder dead, or died between mkdir and writing its pid a minute ago
      if { [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; } \
        || { [ -z "$p" ] && [ -n "$(find "$SLOTS_DIR/$i" -maxdepth 0 -mmin +1 2>/dev/null)" ]; }; then
        rm -rf "${SLOTS_DIR:?}/$i"; continue
      fi
      i=$((i + 1))
    done
    # Every slot is busy, but the machine is half idle (the holders are linking, running a
    # serial test, waiting on Docker): after CK_QA_OVERFLOW seconds of waiting (default 30,
    # 0 = never), start anyway. At most one such start per 30 s machine-wide (an atomic
    # mkdir), so waiters that all see the same low load do not all start before the load
    # average catches up.
    if [ "$QA_OVERFLOW" -gt 0 ] && [ $((SECONDS - t0)) -ge "$QA_OVERFLOW" ]; then
      l="$(load1)"
      if [ -n "$l" ] && [ $((l * 2)) -lt "$NCPU" ] \
        && mkdir "$SLOTS_DIR/o$(( $(date +%s) / 30 ))" 2>/dev/null; then
        find "$SLOTS_DIR" -maxdepth 1 -name 'o*' -mmin +2 -exec rm -rf {} + 2>/dev/null
        SLOT=""; SLOT_IDLE=1; SLOT_WAITED=$((SECONDS - t0))
        [ -z "${1:-}" ] || rm -f "$1"
        slot_env; return 0
      fi
    fi
    [ -z "${1:-}" ] || : >"$1"
    sleep 1
  done
}

slot_free() { [ -z "$SLOT" ] || rm -rf "${SLOTS_DIR:?}/$SLOT"; SLOT=""; }

# Runs QA command $1 into log $2 in its own process group, under a deadline: past
# CK_QA_TIMEOUT seconds (default 3600, 0 = none) the whole group is stopped and $2.timeout
# is left, so a hung build or a suite stuck on a lost container frees its slot instead of
# holding it for hours. Every run is a background run: an e2e suite that reads E2E_HEADLESS
# keeps its window hidden, and PWDEBUG (Playwright's headed inspector) never leaks in.
# Returns the command's exit code, 124 on a timeout.
run_capped() {
  local pid wd="" rc pri=(nice -n "$QA_NICE")
  ! qa_sandboxed || pri=()
  rm -f "$2.timeout"
  set -m
  env -u PWDEBUG E2E_HEADLESS=1 ${pri[@]+"${pri[@]}"} bash -c "$1" >"$2" 2>&1 &
  pid=$!
  set +m
  if [ "$QA_TIMEOUT" -gt 0 ]; then
    ( t=0
      while kill -0 "$pid" 2>/dev/null; do
        if [ "$t" -ge "$QA_TIMEOUT" ]; then
          : >"$2.timeout"; kill -TERM -- "-$pid" 2>/dev/null
          sleep 5; kill -KILL -- "-$pid" 2>/dev/null; exit 0
        fi
        sleep 5; t=$((t + 5))
      done ) &
    wd=$!
  fi
  wait "$pid" 2>/dev/null; rc=$?
  [ -z "$wd" ] || { kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null; }
  [ ! -f "$2.timeout" ] || rc=124
  return "$rc"
}

# Inside a slot, a build tool the project left unset gets this slot's share of the cores
# (CK_QA_JOBS carries it for a command that asks, e.g. ctest -j "${CK_QA_JOBS:-4}"),
# and an installed ccache serves every worktree's cold C/C++ build from one cache (base dir:
# the main checkout, which holds .claude/worktrees/).
slot_env() {
  local share=$(( NCPU / CPU_SLOTS )) base
  [ "$share" -ge 1 ] || share=1
  export CK_QA_IN_SLOT=1
  export CK_QA_JOBS="$share"
  export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-$share}"
  export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-$share}"
  command -v ccache >/dev/null 2>&1 || return 0
  export CMAKE_C_COMPILER_LAUNCHER="${CMAKE_C_COMPILER_LAUNCHER:-ccache}"
  export CMAKE_CXX_COMPILER_LAUNCHER="${CMAKE_CXX_COMPILER_LAUNCHER:-ccache}"
  if [ -z "${CCACHE_BASEDIR:-}" ]; then
    base="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
      && base="$(dirname -- "$base")" && export CCACHE_BASEDIR="$base"
  fi
}
# <<< ck-cpu-slots

# >>> ck-qa-hygiene — byte-identical in ck-code's ck-qa.sh and ck-code-lite's ck-lite-qa
# (plugin-doctor compares the two). A QA run leaves nothing behind that keeps growing.
# Its own logs, stamps and run records under $TMP age out after CK_QA_KEEP_DAYS (default 7).
# Docker is the larger leak: test commands start containers (compose, testcontainers,
# docker run) that nothing removes, every worktree gets its own compose project and volumes,
# and the Docker VM's disk never shrinks by itself. Only what is provably this checkout's is
# removed: a container whose compose working dir is inside it, or a testcontainers one,
# created during the run and stopped by its end, with the volumes it created that nothing
# uses any more, plus the stopped containers of a removed worktree. A container still running
# is only reported. CK_QA_DOCKER=0 turns the Docker part off.
QA_TAG="$(basename -- "$0" .sh)"
KEEP_DAYS="${CK_QA_KEEP_DAYS:-7}"
case "$KEEP_DAYS" in ''|*[!0-9]*|0) KEEP_DAYS=7 ;; esac
NL='
'
US="$(printf '\037')"   # field separator: a tab in IFS would merge empty fields

# Deletes this runner's files in $TMP older than KEEP_DAYS, at most once a day: logs named
# $1<number>-…, and the stamps and run records under $2…. find deletes them itself and never
# follows a symlink, so a planted link in a shared /tmp can never steer a deletion.
qa_prune() {
  local prefix="$1" mark d; shift
  mark="$TMP/${prefix}qa-pruned"
  [ -z "$(find "$mark" -maxdepth 0 -mmin -1440 2>/dev/null)" ] || return 0
  : >"$mark" 2>/dev/null || return 0
  find "$TMP" -maxdepth 1 -type f -name "${prefix}[0-9]*.log*" -mtime +"$KEEP_DAYS" -exec rm -f {} + 2>/dev/null
  find "$TMP" -maxdepth 1 -type f -name "${prefix}qa-index.*" -mmin +1440 -exec rm -f {} + 2>/dev/null
  for d in "$@"; do
    [ -d "$d" ] || continue
    find "$d" -mindepth 1 -maxdepth 3 -type f -mtime +"$KEEP_DAYS" -exec rm -f {} + 2>/dev/null
    find "$d" -mindepth 1 -type d -empty -delete 2>/dev/null
  done
  return 0
}

DK_ON=0; DK_C0=""; DK_V0=""

dk_up() {  # 0 when a Docker daemon answers within 5 s, so a stopped VM never stalls a run
  local p i=0
  { [ "${CK_QA_DOCKER:-1}" != 0 ] && command -v docker >/dev/null 2>&1; } || return 1
  docker version --format '{{.Server.Version}}' >/dev/null 2>&1 &
  p=$!
  while kill -0 "$p" 2>/dev/null; do
    [ "$i" -lt 25 ] || { kill "$p" 2>/dev/null; return 1; }
    sleep 0.2; i=$((i + 1))
  done
  wait "$p"
}

# One row per container, fields separated by $US: id, state, compose working dir, compose project,
# testcontainers flag, name.
dk_ps() {
  docker ps -a --no-trunc --format "{{.ID}}$US{{.State}}$US{{.Label \"com.docker.compose.project.working_dir\"}}$US{{.Label \"com.docker.compose.project\"}}$US{{.Label \"org.testcontainers\"}}$US{{.Names}}" 2>/dev/null
}

under() { case "$1/" in "$2"/*) return 0 ;; esac; return 1; }   # path $1 is $2 or inside it

dk_mark() {  # before the commands: what already exists is never touched
  dk_up || return 0
  DK_ON=1
  DK_C0="$(dk_ps | cut -d "$US" -f1)"
  DK_V0="$(docker volume ls -q 2>/dev/null)"
}

# The compose project name a worktree directory named $1 gets by default — the only name
# provably its own: a compose file in a subfolder is named after that folder, and two
# checkouts sharing that name share its volumes.
own_proj() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9_-'; }

# Removes containers $1 (space-separated ids, with their anonymous volumes), then each
# volume no container uses that is either of a project in $2 (" p1 p2 ", any age) or listed
# in $4 (newline-separated, created during the run) and anonymous or of a project in $3.
# Prints "<containers> <volumes>" removed.
dk_remove() {
  local ids="$1" projs="$2" fprojs="$3" fresh="$4" nc=0 nv=0 v pj ok
  # shellcheck disable=SC2086  # $ids is a word list of container ids
  [ -z "${ids# }" ] || nc="$(docker rm -f -v $ids 2>/dev/null | grep -c .)"
  while IFS="$US" read -r v pj; do
    [ -n "$v" ] || continue
    ok=0
    case "$projs" in *" $pj "*) [ -z "$pj" ] || ok=1 ;; esac
    case "$NL$fresh$NL" in *"$NL$v$NL"*)
      if [ -n "$pj" ]; then case "$fprojs" in *" $pj "*) ok=1 ;; esac
      else case "$v" in *[!0-9a-f]*) ;; *) [ "${#v}" -ne 64 ] || ok=1 ;; esac; fi ;;
    esac
    [ "$ok" = 1 ] && docker volume rm "$v" >/dev/null 2>&1 && nv=$((nv + 1))
  done <<EOF
$(docker volume ls -f dangling=true --format "{{.Name}}$US{{.Label \"com.docker.compose.project\"}}" 2>/dev/null)
EOF
  echo "$nc $nv"
}

# After the commands, for checkout $1: removes what the run left behind and prints one line
# when it removed or found anything.
dk_sweep() {
  local top="$1" wts id st wd pj tc nm own c ids="" projs=" " fprojs=" " run="" fresh="" v r
  [ "$DK_ON" = 1 ] && dk_up || return 0
  wts="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    && wts="$(dirname -- "$wts")/.claude/worktrees"
  while IFS="$US" read -r id st wd pj tc nm; do
    [ -n "$id" ] || continue
    own=""
    case "$NL$DK_C0$NL" in *"$NL$id$NL"*) ;; *)
      # a worktree nested in this checkout is its own checkout, never this run's
      { [ -n "$wd" ] && under "$wd" "$top" && { [ -z "$wts" ] || under "$top" "$wts" || ! under "$wd" "$wts"; }; } \
        || [ "$tc" = true ] && own=fresh ;;
    esac
    # a removed worktree's container: its directory is gone, nothing can use it again
    if [ -n "$wd" ] && [ -n "$wts" ] && under "$wd" "$wts"; then
      c="${wd#"$wts"/}"; c="${c%%/*}"; [ -d "$wts/$c" ] || own=gone
    fi
    [ -n "$own" ] || continue
    case "$st" in
      running|restarting|paused) run="$run $nm"; continue ;;
    esac
    ids="$ids $id"
    [ -n "$pj" ] || continue
    if [ "$own" = gone ]; then [ "$pj" != "$(own_proj "$c")" ] || projs="$projs$pj "
    else fprojs="$fprojs$pj "; fi
  done <<EOF
$(dk_ps)
EOF
  while IFS= read -r v; do
    case "$NL$DK_V0$NL" in *"$NL$v$NL"*) ;; *) [ -z "$v" ] || fresh="$fresh$v$NL" ;; esac
  done <<EOF
$(docker volume ls -q 2>/dev/null)
EOF
  r="$(dk_remove "$ids" "$projs" "$fprojs" "$fresh")"
  [ "$r" = "0 0" ] || echo "$QA_TAG: Docker — removed ${r% *} stopped container(s) and ${r#* } volume(s) the test commands left behind"
  [ -z "$run" ] || echo "$QA_TAG: NOTE — still running from the test commands:$run (docker compose down -v where they started frees them and their volumes)"
  return 0
}

# Every container whose compose working dir is linked worktree $1 or inside it — running
# or not — and the volumes of its own compose project: the worktree is being parked or
# removed. Refuses the main checkout. Prints one line when it removed anything.
dk_free() {
  local root gd cd id st wd pj tc nm ids="" projs=" " mine r
  root="$(CDPATH='' cd -- "$1" 2>/dev/null && pwd -P)" || { echo "$QA_TAG: $1 — no such directory"; return 1; }
  gd="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null)"
  cd="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  if [ -z "$gd" ] || [ "$(CDPATH='' cd -- "$gd" && pwd -P)" = "$(CDPATH='' cd -- "$cd" && pwd -P)" ]; then
    echo "$QA_TAG: $1 — not a linked worktree, refused (the main checkout's containers are the user's)"; return 1
  fi
  dk_up || return 0
  mine="$(own_proj "$(basename -- "$root")")"
  while IFS="$US" read -r id st wd pj tc nm; do
    { [ -n "$id" ] && [ -n "$wd" ] && under "$wd" "$root"; } || continue
    ids="$ids $id"; [ "$pj" != "$mine" ] || projs="$projs$pj "
  done <<EOF
$(dk_ps)
EOF
  [ -n "$ids" ] || return 0
  r="$(dk_remove "$ids" "$projs" " " "")"
  echo "$QA_TAG: Docker — removed ${r% *} container(s) and ${r#* } volume(s) of $1"
}
# Prints "<name> <state> <working dir>" for each container of this repository whose
# worktree directory under .claude/worktrees/ is gone — read-only, for the doctor.
dk_orphans() {
  local wts id st wd pj tc nm c
  dk_up || return 0
  wts="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  wts="$(dirname -- "$wts")/.claude/worktrees"
  while IFS="$US" read -r id st wd pj tc nm; do
    { [ -n "$wd" ] && under "$wd" "$wts"; } || continue
    c="${wd#"$wts"/}"; c="${c%%/*}"
    [ -d "$wts/$c" ] || printf '%s %s %s\n' "$nm" "$st" "$wd"
  done <<EOF
$(dk_ps)
EOF
}
# <<< ck-qa-hygiene

# >>> ck-qa-reap — byte-identical in ck-code's ck-qa.sh and ck-code-lite's ck-lite-qa
# An agent that polls a QA run by hand — `until [ -s <task>.output ]; do sleep 10; done`,
# `while pgrep -f "…qa…"; do sleep 5; done` — leaves that shell behind when it returns, and
# some never end. qa_reap stops this session's leftover wait loops: shells under the nearest
# `claude` ancestor process, at least CK_QA_REAP_AGE s old (120), whose command is an until/while loop that
# sleeps on a QA run, a pgrep or a task output file (CK_QA_REAP_AGE sets the age, in s). Never this shell or its ancestors, never
# another session. Prints one line per loop stopped, then the count. Only an orchestrator runs
# it, once every agent it dispatched has returned — a live agent's wait would be stopped too.
qa_reap() {
  local p=$$ top="" chain=" " n=0 pid
  while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
    chain="$chain$p "
    if [ "$(basename -- "$(ps -o comm= -p "$p" 2>/dev/null)")" = claude ]; then top=$p; break; fi
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
  done
  [ -n "$top" ] || { echo "reap: no Claude Code session above this shell — nothing stopped"; return 0; }
  for pid in $(ps -A -o pid=,ppid=,etime=,command= | awk -v top="$top" -v chain="$chain" -v min="${CK_QA_REAP_AGE:-120}" '
      function secs(t,   a, n, d, s, i) {
        d = 0; if (index(t, "-")) { d = substr(t, 1, index(t, "-") - 1); t = substr(t, index(t, "-") + 1) }
        n = split(t, a, ":"); s = 0; for (i = 1; i <= n; i++) s = s * 60 + a[i]
        return d * 86400 + s
      }
      { pid[NR] = $1; par[$1] = $2; age[$1] = secs($3); c = $0; sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+[^ \t]+[ \t]+/, "", c); cmd[$1] = c }
      END {
        for (i = 1; i <= NR; i++) {
          q = pid[i]; if (index(chain, " " q " ") || age[q] < min + 0) continue
          c = cmd[q]
          if (c !~ /(^|[^A-Za-z_])(until|while)[ \t]/ || c !~ /sleep/) continue
          if (c !~ /ck-(lite-)?qa|pgrep|\.output|\/rc([^A-Za-z]|$)/) continue
          # a descendant of this session only
          for (a = par[q]; a != "" && a > 1 && a != top; a = par[a]) ;
          if (a == top) print q
        }
      }'); do
    echo "reap: stopped $pid — $(ps -o command= -p "$pid" 2>/dev/null | sed -E 's/.*(^|[^A-Za-z_])((until|while)[[:space:]])/\2/' | cut -c1-100)"
    pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null && n=$((n + 1))
  done
  echo "reap: stopped $n leftover wait loop(s)"
}
# <<< ck-qa-reap

# The run directory of id $1. <dir>.lane, when it is there, names the background run's record.
run_dir() { printf '%s/%s' "$RUNS" "$1"; }

# Waits on the run for $1 for up to CK_LITE_QA_WAIT seconds, then prints its result and exits
# with its code, or prints RUNNING and exits 3 while it is still going.
await_run() {
  local d p budget="${CK_LITE_QA_WAIT:-170}" t0=$SECONDS polls=0 q end="${2:-}"
  d="$(run_dir "$1")"; p="$d.lane"; [ ! -f "$p" ] || d="$(cat "$p")"
  [ -f "$d/pid" ] || die "no ck-lite-qa run for $1 — start it with ck-lite-qa run $1 …"
  while [ ! -f "$d/rc" ]; do
    if if [ -f "$d/meta" ]; then lane_dead "$d"; else ! kill -0 "$(cat "$d/pid")" 2>/dev/null; fi; then
      [ -f "$d/rc" ] && break
      die "the ck-lite-qa run for $1 stopped without a result — start it again with ck-lite-qa run"
    fi
    if [ "$end" != --end ] && [ $((SECONDS - t0)) -ge "$budget" ]; then
      q=""; [ ! -f "$d/queued" ] || q=" (queued for a CPU slot — other runs hold all $CPU_SLOTS)"
      echo "ck-lite-qa: RUNNING — $1 has run $(( $(date +%s) - $(cat "$d/start") ))s$q; run 'cd $(pwd -P) && ck-lite-qa wait $1' to keep waiting (runs are per checkout), never start it again and never poll it with your own until/while loop"
      exit 3
    fi
    # quick polls first, so a sub-second suite is not billed a 2 s sleep
    polls=$((polls + 1)); if [ "$polls" -le 10 ]; then sleep 0.2; else sleep 2; fi
  done
  # replaced by a newer run under the same id → that one is the answer
  if [ "$end" = --end ] && [ "$(cat "$d/rc")" = 4 ] && [ -f "$p" ] && [ "$(cat "$p")" != "$d" ]; then
    await_run "$1" --end
  fi
  cat "$d/out"
  exit "$(cat "$d/rc")"
}

# >>> ck-qa-lane — byte-identical in ck-code's ck-qa.sh and ck-code-lite's ck-lite-qa
# (plugin-doctor compares the two). The background lane: `start` checks one commit in a
# checkout of its own, so nobody waits for a suite and an edit can never disturb one. There is
# one lane per repository, a locked detached worktree under CK_QA_LANE_DIR (~/.ck-qa/lanes),
# kept warm between runs and freed by `lane-free`, or once unused for CK_QA_KEEP_DAYS.
# Dependencies are copied (copy-on-write where the disk can) from the caller's checkout while its
# lockfiles are the commit's, else installed. Runs queue; a newer run of the same commands replaces one still
# queued. Each run leaves a record under <git dir>/ck-qa, which `gate` reads: the one place
# that waits, before anything is shipped. `.ck-qa-lane` at the repo root adds
# `setup: <command>` (after the dependencies, when they or this file change) or `off` (runs
# in the caller's checkout, which must then be left alone until the run ends).
LANE_HOME="${CK_QA_LANE_DIR:-$HOME/.ck-qa/lanes}"
LANE_LOCKS="package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock bun.lock bun.lockb uv.lock poetry.lock composer.lock requirements.txt"

lane_init() {  # sets LANE, LANE_MAIN and LANE_REC; 1 outside a git repository with a commit
  local gcd
  # a git hook exports GIT_DIR and friends: they would aim the lane's git at the caller's checkout
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars) 2>/dev/null
  export GIT_TERMINAL_PROMPT=0
  gcd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  git rev-parse -q --verify HEAD >/dev/null 2>&1 || return 1
  LANE_MAIN="$(dirname -- "$gcd")"; LANE_REC="$gcd/ck-qa"
  if ! { mkdir -p "$LANE_HOME" && chmod 700 "$LANE_HOME" && [ -w "$LANE_HOME" ]; } 2>/dev/null; then
    LANE_HOME="$TMP/ck-qa-lanes"; mkdir -p "$LANE_HOME" && chmod 700 "$LANE_HOME" || return 1
  fi
  LANE_HOME="$(CDPATH='' cd -- "$LANE_HOME" && pwd -P)"
  LANE="$LANE_HOME/$(basename -- "$LANE_MAIN" | tr -c 'A-Za-z0-9._\n' '-')-$(printf '%s' "$gcd" | cksum | cut -d' ' -f1)"
  mkdir -p "$LANE_REC"
}

# The one place a lane path is deleted: refuses anything that is not strictly inside LANE_HOME.
lane_rm() {
  local p
  for p in "$@"; do
    case "$p" in *..*) return 1 ;; "${LANE_HOME:?}"/?*) ;; *) return 1 ;; esac
    rm -rf -- "${p:?}"
  done
}

rec_get() { sed -n "s/^$2=//p" "$1/meta" 2>/dev/null | head -n 1; }   # record, field
lane_anc() { git merge-base --is-ancestor "$1" "$2" 2>/dev/null; }
# a pid file holds the pid and when that process started, so a reused pid is never taken for it
lane_born() {  # on Linux the kernel's start tick: there ps computes lstart anew, a second off
  if [ -r "/proc/$1/stat" ]; then sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d ' ' -f 20
  else ps -o lstart= -p "$1" 2>/dev/null; fi
}
lane_pid() { printf '%s\n%s\n' "$1" "$(lane_born "$1")" >"$2"; }
lane_gone() {  # pid file → 0 when its process has ended
  local p; p="$(sed -n 1p "$1" 2>/dev/null)"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 0
  [ "$(sed -n 2p "$1")" != "$(lane_born "$p")" ]
}
lane_dead() { lane_gone "$1/pid"; }
lane_recs() {  # record names, oldest first; -r newest first
  local d
  for d in "$LANE_REC"/r[0-9]*; do [ ! -d "$d" ] || echo "${d##*/}"; done | sort "$@"
}
lane_trunk() {  # ref → where it left the trunk, what `auto` means; nothing when there is none
  local t
  for t in origin/HEAD origin/main origin/master origin/develop main master develop; do
    git rev-parse -q --verify "$t^{commit}" >/dev/null 2>&1 && git merge-base "$1" "$t" 2>/dev/null && return 0
  done
  return 1
}
lane_off() { git show "$1:.ck-qa-lane" 2>/dev/null | grep -qx 'off'; }   # commit
# runs in the caller's checkout: the lane is off, or the sandbox refuses the worktree (.git/worktrees)
# and keeps the caller waiting in its Bash call until the run ends
lane_here() { lane_off "$1" || qa_sandboxed; }
lane_locks() {  # the lockfiles the lane's commit tracks, one per line
  local f p=()
  for f in $LANE_LOCKS; do p[${#p[@]}]="$f"; p[${#p[@]}]="*/$f"; done
  git -C "$LANE" ls-files -- "${p[@]}"
}

# Copies directory $1 to lane path $2: copy-on-write where the disk can, else a plain copy, which
# costs what an install would and needs no network. Never a hard link: a run may write in it.
lane_clone() {
  case "$(uname -s)" in
    Darwin) /bin/cp -cR "$1" "$2" 2>/dev/null ;;
    *) cp -a --reflink=auto "$1" "$2" 2>/dev/null ;;
  esac && return 0
  lane_rm "$2"; cp -a "$1" "$2" 2>/dev/null && return 0
  lane_rm "$2"; return 1
}

lane_run() {  # dir, command, what — runs a setup command; prints why when it fails
  ( cd "$1" && run_capped "$2" "$LANE.setup.log" ) </dev/null \
    || { echo "$3 failed: $(tail -n 1 "$LANE.setup.log")"; return 1; }
}

# The dependency folders of checkout $1: every node_modules, and a gitignored vendor/.
lane_depdirs() {
  find "$1" \( -name .git -o -path "$1/.claude/worktrees" \) -prune -o -type d -name node_modules -prune -print 2>/dev/null
  [ ! -d "$1/vendor" ] || ! git -C "$1" check-ignore -q vendor || echo "$1/vendor"
}

# Brings the dependencies of commit $2 into the lane, from checkout $1 when its lockfiles are
# the commit's. Prints why on failure.
lane_deps() {
  local src="$1" c="$2" key f d rel l same=1 have=0 locks
  locks="$(lane_locks)"
  key="$( { git -C "$LANE" ls-files -s -- '*.prisma' .ck-qa-lane
            if [ -n "$locks" ]; then printf '%s\n' "$locks" | while IFS= read -r f; do git -C "$LANE" ls-files -s -- ":(literal)$f"; done
            else git -C "$LANE" ls-files -s -- package.json '*/package.json'; fi; } | git hash-object --stdin)"
  [ "$(cat "$LANE.deps" 2>/dev/null)" != "$key" ] || return 0
  lane_rm "$LANE.deps"
  while IFS= read -r d; do [ -z "$d" ] || lane_rm "$d"; done <<DIRS
$(lane_depdirs "$LANE")
DIRS
  while IFS= read -r f; do
    [ -z "$f" ] || [ "$(git -C "$LANE" rev-parse "$c:$f" 2>/dev/null)" = "$(git hash-object "$src/$f" 2>/dev/null)" ] || same=0
  done <<LOCKS
$locks
LOCKS
  if [ "$same" = 1 ] && [ -d "$src" ]; then
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      rel="${d#"$src"/}"
      [ -d "$LANE/$(dirname -- "$rel")" ] || continue
      lane_clone "$d" "$LANE/$rel" || { same=0; break; }
      have=1
      lane_rm "$LANE/$rel/.vite" "$LANE/$rel/.cache"
      # a link to the caller's checkout would test the caller's code
      find "$LANE/$rel" -type l -lname "$src/*" 2>/dev/null | while IFS= read -r l; do
        f="$(readlink "$l")"; ln -sfn "$LANE/${f#"$src"/}" "$l"
      done
    done <<DIRS
$(lane_depdirs "$src")
DIRS
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rel="$(dirname -- "$f")"; l=""
    if [ "$same" = 0 ] || [ "$have" = 0 ]; then
      case "$(basename -- "$f")" in
        pnpm-lock.yaml) l='pnpm install --frozen-lockfile --prefer-offline' ;;
        package-lock.json|npm-shrinkwrap.json) l='npm ci --prefer-offline --no-audit --no-fund' ;;
        yarn.lock) l='yarn install --frozen-lockfile --prefer-offline || yarn install --immutable' ;;
        bun.lock|bun.lockb) l='bun install --frozen-lockfile' ;;
        composer.lock) l='composer install -n -q' ;;
      esac
    fi
    # a virtualenv holds absolute paths, so it is made here, never cloned
    if [ -d "$src/$rel/.venv" ]; then
      case "$(basename -- "$f")" in
        uv.lock) l='uv sync --frozen' ;;
        poetry.lock) l='POETRY_VIRTUALENVS_IN_PROJECT=1 poetry install -n' ;;
        requirements.txt) [ -f "$LANE/$rel/uv.lock" ] || [ -f "$LANE/$rel/poetry.lock" ] \
          || l='{ [ -d .venv ] || python3 -m venv .venv; } && .venv/bin/pip install -q -r requirements.txt' ;;
      esac
    fi
    [ -z "$l" ] || lane_run "$LANE/$rel" "$l" "the install in $rel" || return 1
  done <<LOCKS
$locks
LOCKS
  l="$(sed -n 's/^setup:[[:space:]]*//p' "$LANE/.ck-qa-lane" 2>/dev/null)"
  [ -z "$l" ] || lane_run "$LANE" "$l" "the .ck-qa-lane setup" || return 1
  printf '%s' "$key" >"$LANE.deps"
}

# Copies the gitignored files a suite reads from checkout $1: every one ignored by itself (a
# .env, a service-account key) up to 1 MB, and what .worktreeinclude names. An ignored folder
# (dependencies, build output) is never walked into.
lane_env() {
  local src="$1" f
  { git -C "$src" ls-files -o -i --exclude-standard --directory | grep -Ev '/$|\.(log|tsbuildinfo|pyc|tmp)$|(^|/)\.DS_Store$'
    [ ! -f "$src/.worktreeinclude" ] || git -C "$src" ls-files -o -i --exclude-from="$src/.worktreeinclude" \
      | grep -Ev '(^|/)(node_modules|\.venv|target)/'
  } 2>/dev/null | grep -v '^\.claude/worktrees/' | while IFS= read -r f; do
    [ -f "$src/$f" ] && [ ! -L "$src/$f" ] && git -C "$src" check-ignore -q -- "$f" || continue
    [ -d "$LANE/$(dirname -- "$f")" ] && [ -z "$(find "$src/$f" -size +2048 2>/dev/null)" ] || continue
    cp -p "$src/$f" "$LANE/$f"
  done
  return 0
}

# What log $1 says failed, with what moves from run to run taken out (colours, line and column
# numbers, times, the lane's path), one sorted line each, repeats kept: every line naming a file or
# a test, the passing ones and the wrappers' own ("Command failed", "Found 1 error") aside.
lane_fails() {
  LC_ALL=C sed -E $'s/\x1b\\[[0-9;]*m//g' "$1" 2>/dev/null | sed -E "s#${LANE}/?##g; s#\\([0-9]+,[0-9]+\\)##g; s#:[0-9]+(:[0-9]+)?##g; s#\\(?[0-9.]+ ?m?s\\)?([^a-zA-Z]|\$)#\\1#g; s#^[[:space:]]+##; s#[[:space:]]+\$##" \
    | grep -E '[A-Za-z0-9_-]\.[A-Za-z]{1,6}([^A-Za-z]|$)|::|●|✕|✗|×|[Nn]ot ok|[Ee]rror|[Ff]ail' \
    | grep -Evi '^(PASS|RUN|ok|✓|✔|√|stdout|stderr|at|❯|>|\$)([ |]|$)|^(Tests|Test Files|Test Suites|Snapshots|Time|Ran all|Start at|Duration)[: ]' \
    | grep -Evi 'ELIFECYCLE|command failed|exit(ed)? (code|status)|with code [0-9]|^make(\[[0-9]+\])?: \*\*\*|found [0-9]+ (error|problem|file)|^npm (error|err!)|[0-9]+ (problems?|errors?)( |\()|[0-9]+ (failed|failing|passed)' \
    | LC_ALL=C sort
}

# Runs label $2 of record $1 in the lane, its answer in <record>/$3res-<label> ("<verdict> <exit
# code> <log>", then the tracked files it changed). The tree is the commit's again afterwards.
lane_one() {
  local r="$1" l="$2" d
  rm -f "${r:?}/$3res-$l"
  ( cd "$LANE/$(rec_get "$r" prefix)" 2>/dev/null && LANE_RES="$r/$3res" D="$r" "$SELF" __worker "$(rec_get "$r" id)${3:+.$3}" --reuse "$l=$(cat "$r/run-$l")" 2>&1 )
  if d="$(lane_dirty)"; then
    printf '%s\n' "$d" >>"$r/$3res-$l"
    git -C "$LANE" checkout -q -f HEAD -- . >/dev/null 2>&1
  fi
}
lane_res() { sed -n 1p "$1" 2>/dev/null | cut -d ' ' -f "$2"; }   # result file, field

# Which of labels $3… of record $1 are no worse than on base commit $2? Runs them there, in the
# lane, and prints each that failed there the same way, with no failure line of its own, or that
# changes the same tracked files there. The answer is kept per (base, directory, command). A
# chained command proves nothing: what fails first hides the rest.
lane_baseline() {
  local r="$1" b="$2" l k todo="" k2; shift 2
  for l in "$@"; do
    k="$LANE_REC/base-$( { echo "$b"; rec_get "$r" prefix; cat "$r/run-$l"; } | git hash-object --stdin)"
    [ -f "$k" ] || todo="$todo $l"
  done
  if [ -n "$todo" ]; then
    ( cd "$LANE_MAIN" && lane_prepare "$b" "$(rec_get "$r" src)" ) >/dev/null 2>&1 || return 0
    for l in $todo; do
      k="$LANE_REC/base-$( { echo "$b"; rec_get "$r" prefix; cat "$r/run-$l"; } | git hash-object --stdin)"
      lane_one "$r" "$l" base >/dev/null
      [ -s "$r/baseres-$l" ] || continue
      case "$(lane_res "$r/baseres-$l" 1)" in
        FAIL) lane_fails "$(sed -n 1p "$r/baseres-$l" | cut -d ' ' -f 3-)" >"$k" ;;
        PASS|REUSED) : >"$k" ;;
        *) continue ;;
      esac
      { lane_res "$r/baseres-$l" 2; sed 1d "$r/baseres-$l"; } >"$k.rc"
    done
  fi
  for l in "$@"; do
    k="$LANE_REC/base-$( { echo "$b"; rec_get "$r" prefix; cat "$r/run-$l"; } | git hash-object --stdin)"
    [ -f "$k.rc" ] || continue
    [ "$(sed 1d "$k.rc")" = "$(sed 1d "$r/res-$l")" ] || continue
    if [ "$(lane_res "$r/res-$l" 1)" != FAIL ]; then echo "$l"; continue; fi   # same files changed, and it passed
    case "$(cat "$r/run-$l")" in *'&&'*|*';'*|*'||'*) continue ;; esac
    k2="$(lane_res "$r/res-$l" 2)"
    [ "$k2" = "$(sed -n 1p "$k.rc")" ] && [ "${k2:-999}" -lt 124 ] || continue
    lane_fails "$(sed -n 1p "$r/res-$l" | cut -d ' ' -f 3-)" >"$r/fails-$l"
    # never without a failure line on both sides: silence proves nothing
    [ -s "$k" ] && [ -s "$r/fails-$l" ] || continue
    LC_ALL=C comm -23 "$r/fails-$l" "$k" >"$r/new-$l"
    [ -s "$r/new-$l" ] || echo "$l"
  done
}

# Drops everything a run left but the dependencies and the build trees that check their own
# inputs (cargo, CMake): an old dist/ must never stand in for a build that fails.
lane_clean() {
  local x=(-e node_modules -e .venv -e vendor)
  [ -z "$(git -C "$LANE" ls-files -- Cargo.toml '*/Cargo.toml')" ] || x[${#x[@]}]=--exclude=target
  [ -z "$(git -C "$LANE" ls-files -- CMakeLists.txt)" ] || x[${#x[@]}]='--exclude=/build*'
  git -C "$LANE" clean -fdxq "${x[@]}" >/dev/null 2>&1
}

lane_dirty() { git -C "$LANE" diff --name-only HEAD 2>/dev/null | grep .; }   # tracked files changed

# Puts commit $1 in the lane, set up from checkout $2. Prints why on failure.
lane_prepare() {
  local c="$1" src="$2" p
  [ -d "$src" ] || src="$LANE_MAIN"
  # the lane itself, never a repository above it: what follows discards files
  if [ -e "$LANE/.git" ] && [ "$(git -C "$LANE" rev-parse --show-toplevel 2>/dev/null)" = "$LANE" ]; then
    git -c core.hooksPath=/dev/null -C "$LANE" checkout -q --detach -f "$c" >/dev/null 2>&1 \
      && lane_clean || { echo "cannot check out $c in $LANE"; return 1; }
  else
    lane_rm "$LANE" "$LANE.deps"
    git -c core.hooksPath=/dev/null -C "$LANE_MAIN" worktree add -f -f --detach "$LANE" "$c" >"$LANE.setup.log" 2>&1 \
      || { echo "cannot create the lane checkout: $(tail -n 1 "$LANE.setup.log")"; return 1; }
    git -C "$LANE_MAIN" worktree lock --reason "ck-qa lane" "$LANE" >/dev/null 2>&1
  fi
  if [ -f "$LANE/.gitmodules" ]; then
    git config -f "$LANE/.gitmodules" --get-regexp '^submodule\..*\.path$' | while read -r _ p; do
      [ -e "$LANE_MAIN/$p/.git" ] && [ ! -e "$LANE/$p/.git" ] \
        && git -C "$LANE" submodule update --init --reference "$LANE_MAIN/$p" --dissociate -- "$p" >/dev/null 2>&1
    done
    lane_run "$LANE" 'git submodule update --init --recursive' "fetching its submodules" || return 1
  fi
  lane_deps "$src" "$c" && lane_env "$src" || return 1
  # what the setup wrote over tracked files is not the commit
  lane_dirty >/dev/null && git -C "$LANE" checkout -q -f "$c" -- . >/dev/null 2>&1
  return 0
}

lane_lock() {  # waits for the lane; 1 when record $1 was replaced meanwhile
  while ! mkdir "$LANE.lock" 2>/dev/null; do
    [ ! -d "$1/claimed" ] || return 1
    # taken over by one waiter at a time, the holder checked again inside
    if lane_stale && mkdir "$LANE.lock.steal" 2>/dev/null; then
      ! lane_stale || lane_rm "$LANE.lock"
      lane_rm "$LANE.lock.steal"; continue
    fi
    [ -z "$(find "$LANE.lock.steal" -maxdepth 0 -mmin +2 2>/dev/null)" ] || lane_rm "$LANE.lock.steal"
    : >"$1/queued"; sleep 1
  done
  lane_pid $$ "$LANE.lock/pid"
}
lane_stale() {  # the holder has ended, or never wrote its pid a minute ago
  if [ -s "$LANE.lock/pid" ]; then lane_gone "$LANE.lock/pid"
  else [ -n "$(find "$LANE.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; fi
}
lane_mine() { [ "$(sed -n 1p "$LANE.lock/pid" 2>/dev/null)" = $$ ]; }
lane_unlock() { ! lane_mine || lane_rm "$LANE.lock"; }

# The newest commit that passed label key $1, lies between $2 and commit $3, and whose own check
# reached back to $2 ("-": it had no base); $2 itself when there is none. Prints it, then the
# base that check covered.
lane_base() {
  local g v
  { [ ! -f "$LANE_REC/green-$1" ] || sed '1!G;h;$!d' "$LANE_REC/green-$1"; echo; } | while read -r g v; do
    [ -n "$g" ] || { printf '%s %s' "${2:--}" "${2:--}"; break; }
    lane_anc "$g" "$3" || continue
    if [ -n "$2" ]; then
      lane_anc "$2" "$g" || continue
      [ "$v" = - ] || lane_anc "$v" "$2" || continue
    fi
    printf '%s %s' "$g" "$v"; break
  done
}

# Is checkout $1 exactly commit $2, apart from what the gate never counts as code (tasks/, docs/,
# Markdown — a fresh plan leaves them uncommitted)? Only a run with the lane off asks.
lane_at() {
  [ "$(git -C "$1" rev-parse "$2^{tree}")" != "$(cd "$1" && state)" ] || return 0
  set -- "$1" "$2" ':(exclude,top)tasks' ':(exclude,top)docs' ':(exclude,top,glob)**/*.md'
  git -C "$1" diff --quiet "$2" -- "${@:3}" \
    && [ -z "$(git -C "$1" ls-files -o --exclude-standard -- "${@:3}")" ]
}

# The detached body of one lane run, for record $1.
lane_work() {
  local r="$1" c src pre l cmd b v x t bad="" where="" fails="" args=()
  c="$(rec_get "$r" commit)"; src="$(rec_get "$r" src)"; pre="$(rec_get "$r" prefix)"
  if lane_here "$c"; then
    mkdir "$r/claimed" 2>/dev/null || return 4
    where="$src"
    lane_at "$src" "$c" || bad="the checkout is not at this commit any more (.ck-qa-lane is off)"
  else
    lane_lock "$r" || return 4
    trap lane_unlock EXIT
    mkdir "$r/claimed" 2>/dev/null || return 4
    rm -f "${r:?}/queued"; : >"$LANE.used"; where="$LANE"
    bad="$(lane_prepare "$c" "$src")"
    [ -n "$bad" ] || lane_mine || bad="another run took the lane over"
    # the caller's virtualenv would import the caller's code
    x="${VIRTUAL_ENV:-}"; unset VIRTUAL_ENV PYTHONPATH NODE_PATH
    if [ -n "$x" ]; then PATH="$(printf '%s' ":$PATH:" | sed "s#:$x/bin:#:#g; s#^:##; s#:\$##")"; fi
    for x in "$LANE/.venv/bin" "$LANE/$pre.venv/bin"; do [ ! -d "$x" ] || PATH="$x:$PATH"; done
    export PATH
  fi
  if [ -z "$bad" ] && ! cd "$where/$pre" 2>/dev/null; then bad="$pre does not exist at this commit"; fi
  if [ -z "$bad" ]; then
    for l in $(cat "$r/labels"); do
      cmd="$(cat "$r/cmd-$l")"
      read -r b v <<BASE
$(lane_base "$(cat "$r/key-$l")" "$(rec_get "$r" base)" "$c")
BASE
      case "$cmd" in *'{base}'*) cmd="${cmd//\{base\}/$b}" ;; *) v=- ;; esac
      printf '%s' "$v" >"$r/covers-$l"
      case "$cmd" in @*)
        printf '%s\n' "${cmd#@}" >"$r/scope.sh"
        run_capped "bash '$r/scope.sh' >'$r/scope.out' 2>'$r/scope.err'" /dev/null; x="$?"
        cmd="$(cat "$r/scope.out" 2>/dev/null)"
        if [ "$x" != 0 ] || [ -z "${cmd//[[:space:]]/}" ]; then
          bad="the $l scope command failed: $(tail -n 1 "$r/scope.err")"; break
        fi ;;
      esac
      args[${#args[@]}]="$l=$cmd"; printf '%s' "$cmd" >"$r/run-$l"
    done
  fi
  if [ -n "$bad" ]; then
    for l in $(cat "$r/labels"); do echo SETUP >"$r/status-$l"; done
    echo "$QA_TAG: FAIL — setup: $bad (no test ran, in $where)"
    return 1
  fi
  # a pool of its own, at a lower priority: a background run never makes a foreground one queue;
  # and one at a time on the machine, since nobody is waiting for it
  export CK_QA_POOL=lane CK_QA_NICE="${CK_QA_NICE:-15}" CK_QA_SLOTS="${CK_QA_LANE_SLOTS:-1}" CK_QA_OVERFLOW=0
  # one label after the other unless --parallel, and never stopped by a failed one: the answer
  # is worth every label
  if [ "$where" != "$LANE" ]; then
    for x in "${args[@]}"; do LANE_RES="$r/res" D="$r" "$SELF" __worker "$(rec_get "$r" id)" "$x" 2>&1; done >"$r/body"
    if ! lane_at "$src" "$c"; then
      for l in $(cat "$r/labels"); do echo FAIL >"$r/status-$l"; done
      cat "$r/body"; echo "$QA_TAG: FAIL — the checkout changed during the run (.ck-qa-lane is off): start it again and leave it alone"
      return 1
    fi
  else
    if [ "$(rec_get "$r" parallel)" = 1 ]; then
      LANE_RES="$r/res" D="$r" "$SELF" __worker "$(rec_get "$r" id)" --reuse --parallel "${args[@]}" >"$r/body" 2>&1
      # one of them changed a tracked file: which, and what did the others read? One by one, then
      if lane_dirty >/dev/null; then git -C "$LANE" checkout -q -f HEAD -- . >/dev/null 2>&1; x=again; else x=""; fi
    else x=again; fi
    [ -z "$x" ] || for l in $(cat "$r/labels"); do lane_one "$r" "$l" ""; done >"$r/body"
    lane_mine || { for l in $(cat "$r/labels"); do echo FAIL >"$r/status-$l"; done; echo "$QA_TAG: FAIL — another run took the lane over: start it again"; return 1; }
  fi
  for l in $(cat "$r/labels"); do
    x="$(lane_res "$r/res-$l" 1)"
    case "$x" in
      PASS|REUSED)
        if [ -z "$(sed 1d "$r/res-$l")" ]; then lane_green "$r" "$l" "$c"; continue; fi ;;
      FAIL) ;;
      *) echo FAIL >"$r/status-$l"; bad="$bad $l"; continue ;;   # a timeout, or no answer: never compared
    esac
    echo FAIL >"$r/status-$l"; bad="$bad $l"; fails="$fails $l"
  done
  # a test that timed out on a busy machine proves nothing: once more, when it is calm
  if [ "$where" = "$LANE" ]; then
    for l in $fails; do
      [ "$(lane_res "$r/res-$l" 1)" = FAIL ] || continue
      grep -Eiq 'timed? ?out|timeout|exceeded' "$(sed -n 1p "$r/res-$l" | cut -d ' ' -f 3-)" 2>/dev/null || continue
      t=0; while x="$(load1)"; [ -n "$x" ] && [ "$x" -ge "$NCPU" ] && [ "$t" -lt 180 ]; do sleep 5; t=$((t + 5)); done
      lane_one "$r" "$l" "" >"$r/again"
      case "$(lane_res "$r/res-$l" 1)" in
        PASS) if [ -z "$(sed 1d "$r/res-$l")" ]; then
                lane_green "$r" "$l" "$c"; fails="${fails/ $l/}"; bad="${bad/ $l/}"; echo "$l" >>"$r/second"
              fi ;;
        FAIL) ;;
        *) fails="${fails/ $l/}" ;;
      esac
    done
  fi
  # what already failed before this work is not its failure
  b="$(rec_get "$r" base)"
  if [ -n "$fails" ] && [ -n "$b" ] && [ "$b" != "$c" ] && [ "$where" = "$LANE" ]; then
    # shellcheck disable=SC2086  # a word list of labels
    for l in $(lane_baseline "$r" "$b" $fails); do
      if [ "$(lane_res "$r/res-$l" 1)" = FAIL ]; then printf 'BASELINE\n%s\n' "$b" >"$r/status-$l"
      else lane_green "$r" "$l" "$c"; fi
      bad="${bad/ $l/}"
    done
  fi
  # the worker's own text, without its verdicts: the ones below are the run's
  grep -v "^$QA_TAG: \(FAIL\|PASS\)" "$r/body"
  for l in $(cat "$r/labels"); do
    case "$(head -n 1 "$r/status-$l")" in
      PASS) x="passed"; ! grep -qx "$l" "$r/second" 2>/dev/null || x="PASS on a second run — the first one timed out"
            [ "$x" = passed ] || echo "$l: $x" ;;
      BASELINE) echo "$l: BASELINE — every failure is already there at ${b:0:9}, none is new" ;;
      *) if [ -s "$r/new-$l" ]; then echo "--- $l: new since ${b:0:9} ---"; head -n 20 "$r/new-$l"
         elif [ -n "$(sed 1d "$r/res-$l" 2>/dev/null)" ] && [ "$(lane_res "$r/res-$l" 1)" != FAIL ]; then
           echo "$l: FAIL — it changes tracked files, so it cannot vouch for the commit (use its check form): $(sed 1d "$r/res-$l" | head -n 5 | tr '\n' ' ')"
         fi ;;
    esac
  done
  if [ -n "$bad" ]; then echo "$QA_TAG: FAIL —$bad"; return 1; fi
  echo "$QA_TAG: PASS"
}
lane_green() {  # record, label, commit
  echo PASS >"$1/status-$2"
  echo "$3 $(cat "$1/covers-$2")" >>"$LANE_REC/green-$(cat "$1/key-$2")"
}

# start <id> [--at <commit>|work] [--base <commit>|auto] [--parallel] <label>=<command>…
lane_start() {
  local id="$1" at=HEAD base="" par=0 l labels="" c anchor br pre top r q o n sup="" x tmp; shift
  case "$id" in ""|*/*|.|..|-*) die "start needs an id without / (got: $id)" ;; esac
  lane_init || die "start needs a git repository with a commit"
  top="$(git rev-parse --show-toplevel)"; pre="$(git rev-parse --show-prefix)"
  tmp="$(mktemp -d "$TMP/ck-qa-start.XXXXXX")" || die "cannot create a temporary folder"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --at) at="${2:-}"; shift ;;
      --base) base="${2:-}"; shift ;;
      --parallel) par=1 ;;
      *=*) l="${1%%=*}"
           case "$l" in ""|*[!A-Za-z0-9_]*) die "label must be [A-Za-z0-9_]+ (got: $l)" ;; esac
           case " $labels " in *" $l "*) die "label $l is given twice" ;; esac
           case "${1#*=}" in *[![:space:]]*) ;; *) die "label $l has an empty command" ;; esac
           labels="$labels $l"; printf '%s' "${1#*=}" >"$tmp/cmd-$l"
           printf '%s\n%s\n' "$pre" "${1#*=}" | git hash-object --stdin >"$tmp/key-$l" ;;
      *) die "expected <label>=<command>, got: $1" ;;
    esac
    shift
  done
  [ -n "$labels" ] || die "no <label>=<command> given"
  case "$base" in
    "") ;;
    auto) base="$(lane_trunk HEAD)" || die "--base auto: no trunk to compare with, pass a commit" ;;
    *) x="$base"; base="$(git rev-parse -q --verify "$x^{commit}")" || die "--base: not a commit: $x" ;;
  esac
  [ -n "$base" ] || ! cat "$tmp"/cmd-* | grep -q '{base}' || die "a command holds {base}: pass --base <commit>"
  anchor="$(git rev-parse HEAD)"; br="$(git branch --show-current)"
  if [ "$at" = work ]; then
    c="$(snapshot "$(state)")"; [ -n "$c" ] || die "cannot snapshot the working copy"
  else
    c="$(git rev-parse -q --verify "$at^{commit}")" || die "--at: not a commit: $at"
    anchor="$c"
  fi
  lane_prune
  # a queued run of the same commands on an older commit of this branch is replaced: this one
  # covers it, since {base} reaches back to the last commit that passed
  for o in $(lane_recs); do
    q="$LANE_REC/$o"
    if [ -f "$q/rc" ] || [ -d "$q/claimed" ] || lane_dead "$q"; then continue; fi
    [ "$(rec_get "$q" branch)" = "$br" ] && [ "$(rec_get "$q" prefix)" = "$pre" ] || continue
    lane_anc "$(rec_get "$q" anchor)" "$c" || continue
    x=1; for l in $(cat "$q/labels"); do cmp -s "$q/cmd-$l" "$tmp/cmd-$l" || x=0; done
    # its base must be one this run can reach back to
    n="$(rec_get "$q" base)"
    if [ -n "$n" ] && [ -n "$base" ] && ! lane_anc "$n" "$base" && ! lane_anc "$base" "$n"; then x=0; fi
    [ "$x" = 1 ] && mkdir "$q/claimed" 2>/dev/null || continue
    [ -z "$n" ] || [ -z "$base" ] || ! lane_anc "$n" "$base" || base="$n"
    for l in $(cat "$q/labels"); do echo SUPERSEDED >"$q/status-$l"; done
    echo "$QA_TAG: SUPERSEDED — $(rec_get "$q" id) was still queued; $id checks a newer commit with the same commands" >"$q/out"
    echo 4 >"$q/rc"; sup="$sup $(rec_get "$q" id)"
  done
  # a run of these commands that has not passed is this run's to cover: reach back to its base
  if [ -n "$base" ]; then
    for l in $labels; do
      for o in $(lane_recs -r); do
        q="$LANE_REC/$o"; n=""
        lane_anc "$(rec_get "$q" anchor)" "$c" || continue
        for x in $(cat "$q/labels" 2>/dev/null); do cmp -s "$q/key-$x" "$tmp/key-$l" && n="$x"; done
        [ -n "$n" ] || continue
        case "$(head -n 1 "$q/status-$n")" in
          SUPERSEDED) continue ;;
          PASS|WAIVED|BASELINE) ;;
          *) n="$(rec_get "$q" base)"; [ -z "$n" ] || ! lane_anc "$n" "$base" || base="$n" ;;
        esac
        break
      done
    done
  fi
  n="$(lane_recs | tail -n 1)"; n="${n#r}"; n=$((10#${n:-0} + 1))
  while ! mkdir "$LANE_REC/$(printf 'r%08d' "$n")" 2>/dev/null; do n=$((n + 1)); done
  r="$LANE_REC/$(printf 'r%08d' "$n")"
  for l in $labels; do mv "$tmp/cmd-$l" "$tmp/key-$l" "$r/"; echo PENDING >"$r/status-$l"; done
  echo "${labels# }" >"$r/labels"; date +%s >"$r/start"
  printf 'id=%s\nbranch=%s\ncommit=%s\nanchor=%s\nbase=%s\nprefix=%s\nsrc=%s\nmain=%s\nparallel=%s\n' \
    "$id" "$br" "$c" "$anchor" "$base" "$pre" "$top" "$LANE_MAIN" "$par" >"$r/meta"
  mkdir -p "$(dirname -- "$(run_dir "$id")")"
  # SIGHUP ignored by hand, never nohup: under the Claude Code sandbox nohup cannot detach (exit 127)
  set -- bash -c 'trap "" HUP; "$0" __lane "$R" >"$R/run" 2>&1; rc=$?
    [ ! -f "$R/rc" ] || exit 0
    mv "$R/run" "$R/out"; echo $rc >"$R/rc.tmp"; mv "$R/rc.tmp" "$R/rc"' "$SELF"
  if qa_foreground; then
    lane_pid $$ "$r/pid"; printf '%s' "$r" >"$(run_dir "$id").lane"
    R="$r" "$@" </dev/null >/dev/null 2>&1
  else
    R="$r" "$@" </dev/null >/dev/null 2>&1 &
    lane_pid $! "$r/pid"; printf '%s' "$r" >"$(run_dir "$id").lane"
  fi
  [ -z "$sup" ] || echo "$QA_TAG: replaced the queued run(s):$sup"
  if qa_foreground; then
    echo "$QA_TAG: FINISHED — $id ran in the foreground: a background run cannot outlive its Bash call here (sandbox or CK_QA_FOREGROUND)"
  elif lane_off "$c"; then
    echo "$QA_TAG: STARTED — $id in this checkout (.ck-qa-lane is off): leave it alone until the run ends"
  else
    echo "$QA_TAG: STARTED — $id on $(git rev-parse --short "$c") in the background lane; keep working"
  fi
  if qa_foreground; then echo "result: '$QA_TAG wait $id --end' (returns at once)"; else
    echo "result: '$QA_TAG wait $id --end' in a background Bash call"
  fi
}

# Old records (30 days), and lanes of other repositories nobody used for KEEP_DAYS.
lane_prune() {
  local l m
  find "${LANE_REC:?}" -maxdepth 2 -path "$LANE_REC/r[0-9]*" -type f -mtime +30 -exec rm -f {} + 2>/dev/null
  find "${LANE_REC:?}" -maxdepth 1 \( -name 'green-*' -o -name 'base-*' \) -mtime +30 -exec rm -f {} + 2>/dev/null
  find "$LANE_HOME" -maxdepth 1 -name '*.used' -mtime +"$KEEP_DAYS" 2>/dev/null | while IFS= read -r l; do
    l="${l%.used}"
    [ "$l" != "$LANE" ] && [ ! -d "$l.lock" ] || continue
    m="$(git -C "$l" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    lane_remove "$l" "$(dirname -- "${m:-/nonexistent/x}")"
  done
}

lane_remove() {  # lane, its main checkout (may be gone)
  case "$1" in "${LANE_HOME:?}"/?*) ;; *) return 1 ;; esac
  [ ! -d "$1" ] || dk_free "$1" 2>/dev/null
  git -C "$2" worktree unlock "$1" >/dev/null 2>&1
  git -C "$2" worktree remove --force "$1" >/dev/null 2>&1 || lane_rm "$1"
  lane_rm "$1.lock" "$1.lock.steal" "$1.deps" "$1.used" "$1.setup.log"
}

lane_free() {
  local o
  lane_init || die "lane-free needs a git repository"
  for o in $(lane_recs); do
    [ -f "$LANE_REC/$o/rc" ] || lane_dead "$LANE_REC/$o" || { echo "$QA_TAG: lane kept — $(rec_get "$LANE_REC/$o" id) is still running"; return 1; }
  done
  [ -e "$LANE" ] || { echo "$QA_TAG: no lane"; return 0; }
  lane_remove "$LANE" "$LANE_MAIN" && echo "$QA_TAG: lane freed — $LANE"
}

# gate [<ref>] [--base <ref>|auto] [--again] — may <ref> (HEAD) be shipped? The latest run of each
# command on this line of work decides, the records reachable from --base excluded. --again
# starts every command that is not green on <ref>.
lane_gate() {
  local ref=HEAD base="" br o r l k st c a id moved seen=" " bad="" pend="" unc="" any=0 again=0
  while [ "$#" -gt 0 ]; do
    case "$1" in --base) base="${2:-}"; shift ;; --again) again=1 ;; *) ref="$1" ;; esac; shift
  done
  lane_init || { echo "$QA_TAG: gate NONE — not a git repository"; return 0; }
  ref="$(git rev-parse -q --verify "$ref^{commit}")" || die "gate: not a commit"
  case "$base" in
    "") ;;
    auto) base="$(lane_trunk "$ref")" || base="" ;;
    *) base="$(git rev-parse -q --verify "$base^{commit}")" || die "gate: --base is not a commit" ;;
  esac
  br="$(git branch --show-current)"
  for o in $(lane_recs -r); do
    r="$LANE_REC/$o"; c="$(rec_get "$r" commit)"; id="$(rec_get "$r" id)"
    [ -n "$c" ] || continue
    a="$(rec_get "$r" anchor)"; moved=0
    if [ "$c" = "$a" ] && [ -n "$base" ] && lane_anc "$c" "$base"; then continue; fi
    if ! lane_anc "$a" "$ref"; then
      # an amend or a rebase replaced its commit: this branch's work still has to answer for it
      [ -n "$br" ] && [ "$(rec_get "$r" branch)" = "$br" ] || continue
      moved=1
    elif [ "$c" != "$a" ] && [ "$(rec_get "$r" branch)" != "$br" ]; then
      # a snapshot of uncommitted work on another branch, unless that branch's work is in ref
      [ -n "$base" ] && ! lane_anc "$a" "$base" || continue
    fi
    for l in $(cat "$r/labels" 2>/dev/null); do
      st="$(head -n 1 "$r/status-$l" 2>/dev/null)"; k="$(cat "$r/key-$l" 2>/dev/null)"
      case "$seen" in *" $k "*) continue ;; esac
      seen="$seen$k "; any=1
      case "$st" in
        SUPERSEDED) st=LOST ;;   # and the run that replaced it is not on this work any more
        PENDING) if [ -f "$r/rc" ] || lane_dead "$r"; then st=LOST; fi ;;
        FAIL|SETUP|'') [ "$moved" = 0 ] || st=LOST ;;
        PASS|BASELINE|WAIVED) git diff --quiet "$c" "$ref" -- ':/' ':(exclude,top)tasks' ':(exclude,top)docs' ':(exclude,top,glob)**/*.md' 2>/dev/null || st=UNCHECKED ;;
      esac
      case "$st" in
        PASS) ;;
        BASELINE) echo "$l ($id): BASELINE — fails as it did at $(git rev-parse --short "$(sed -n 2p "$r/status-$l")"), nothing new" ;;
        WAIVED) echo "$l ($id): WAIVED — $(sed -n 2p "$r/status-$l")" ;;
        PENDING) echo "$l ($id): PENDING — $(( $(date +%s) - $(cat "$r/start") ))s on $(git rev-parse --short "$c")"; pend="$pend $id" ;;
        UNCHECKED) echo "$l ($id): UNCHECKED — passed on $(git rev-parse --short "$c"), code changed since"; unc="$unc $o" ;;
        LOST) echo "$l ($id): LOST — the run ended without a result"; unc="$unc $o" ;;
        *) echo "$l ($id): RED — $st on $(git rev-parse --short "$c")"; bad="$bad $o" ;;
      esac
    done
  done
  if [ "$again" = 1 ]; then
    [ -n "$bad$unc" ] || { echo "$QA_TAG: nothing to check again"; return 0; }
    # shellcheck disable=SC2086  # two word lists of record names
    for o in $(printf '%s\n' $bad $unc | sort -u); do lane_again "$LANE_REC/$o" "$ref"; done
    return 0
  fi
  if [ -n "$bad" ]; then echo "$QA_TAG: gate RED"; return 1; fi
  # shellcheck disable=SC2086
  if [ -n "$pend" ]; then echo "$QA_TAG: gate PENDING — $(printf '%s\n' $pend | sort -u | tr '\n' ' ')"; return 3; fi
  if [ -n "$unc" ]; then echo "$QA_TAG: gate UNCHECKED"; return 5; fi
  if [ "$any" = 0 ]; then echo "$QA_TAG: gate NONE — no background run on this work"; return 0; fi
  echo "$QA_TAG: gate GREEN"
}

lane_again() {  # record, ref — starts its commands again on ref
  local r="$1" l b a=()
  for l in $(cat "$r/labels"); do a[${#a[@]}]="$l=$(cat "$r/cmd-$l")"; done
  b="$(rec_get "$r" base)"
  if [ -n "$b" ]; then a[${#a[@]}]="--base"; a[${#a[@]}]="$b"; fi
  [ "$(rec_get "$r" parallel)" != 1 ] || a[${#a[@]}]="--parallel"
  ( cd "$(git rev-parse --show-toplevel)/$(rec_get "$r" prefix)" && lane_start "$(rec_get "$r" id)" --at "$2" "${a[@]}" )
}

# waive <id> <reason> — the user accepted this run's failure; the gate lets it through.
lane_waive() {
  local o r l
  { [ -n "${1:-}" ] && [ -n "${2:-}" ]; } || die "waive needs <id> \"<reason>\""
  lane_init || die "waive needs a git repository"
  for o in $(lane_recs -r); do
    r="$LANE_REC/$o"
    [ "$(rec_get "$r" id)" = "$1" ] && [ -f "$r/rc" ] && [ "$(cat "$r/rc")" != 4 ] && lane_anc "$(rec_get "$r" anchor)" HEAD || continue
    for l in $(cat "$r/labels"); do
      case "$(head -n 1 "$r/status-$l")" in FAIL|SETUP) printf 'WAIVED\n%s\n' "$2" >"$r/status-$l" ;; esac
    done
    echo "$QA_TAG: $1 waived — $2"; return 0
  done
  die "waive: no ended run for $1"
}
# <<< ck-qa-lane

CMD="${1:-}"
case "$CMD" in
  state) state; exit 0 ;;
  wait) [ -n "${2:-}" ] || die "wait needs an id"; await_run "$2" "${3:-}" ;;
  start) shift; lane_start "$@"; exit $? ;;
  gate) shift; lane_gate "$@"; exit $? ;;
  waive) lane_waive "${2:-}" "${3:-}"; exit $? ;;
  lane-free) lane_free; exit $? ;;
  __lane) cd "$(rec_get "${2:-}" main)" 2>/dev/null && lane_init || die "no such run"; lane_work "$2"; exit $? ;;
  since) [ -n "${3:-}" ] || die "since needs an id and a label"
         last_field "$2" "$3" 1 || die "no recorded run of $3 for $2 in this directory — run the full command"
         exit 0 ;;
  docker-free) shift; [ "$#" -gt 0 ] || die "docker-free needs a worktree path"
               rc=0; for p in "$@"; do dk_free "$p" || rc=1; done; exit "$rc" ;;
  docker-orphans) dk_orphans; exit 0 ;;
  reap) qa_reap; exit 0 ;;
  run|__worker) ;;
  -h|--help|"") sed -n '4,63p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) die "unknown command: $CMD (state|run|start|wait|gate|waive|since|reap|lane-free)" ;;
esac
shift
ARGS=("$@")
ID="${1:-}"; [ -n "$ID" ] || die "run needs an id (the task id, e.g. T-05)"; shift
case "$ID" in */*|.|..) die "id must not contain / (got: $ID)" ;; esac

RES_TO="${LANE_RES:-}"; unset LANE_RES   # never inherited by a command that runs ck-qa itself
PARALLEL=0; REUSE=0; RERUN=0; LABELS=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --parallel) PARALLEL=1 ;;
    --reuse) REUSE=1 ;;
    --rerun) RERUN=1 ;;
    *=*) l="${1%%=*}"
         case "$l" in ""|*[!A-Za-z0-9_]*) die "label must be [A-Za-z0-9_]+, no hyphen (got: $l)" ;; esac
         case "${1#*=}" in *[![:space:]]*) ;; *) die "label $l has an empty command" ;; esac
         LABELS="$LABELS $l"; eval "CMD_$l=\"\${1#*=}\"" ;;
    *) die "expected <label>=<command>, got: $1" ;;
  esac
  shift
done
[ -n "$LABELS" ] || die "no <label>=<command> given"
mkdir -p "$STAMPS" "$RUNS" || die "cannot create $STAMPS"
[ "$CMD" != run ] || qa_prune ck-lite- "$STAMPS" "$TMP/ck-lite-qa-run"

cmd_of() { eval "printf '%s' \"\$CMD_$1\""; }

# The full command a label stands for: the recorded one on a --rerun, else its own. Read
# once here, before this run overwrites the record.
for l in $LABELS; do
  if [ "$RERUN" = 1 ]; then
    f="$(last_field "$ID" "$l" 3)" \
      || die "--rerun: no recorded run of $l for $ID in this directory — run the full command"
  else
    f="$(cmd_of "$l")"
  fi
  eval "FULL_$l=\"\$f\""
done
full_of() { eval "printf '%s' \"\$FULL_$1\""; }

# run: start the commands detached, so a run longer than one Bash call survives it, and
# wait on it (in the foreground where nothing can be detached, see qa_foreground). An
# identical run already going is waited on, never started a second time.
if [ "$CMD" = run ]; then
  D="$(run_dir "$ID")"
  KEY="$( { pwd -P; echo "$PARALLEL $REUSE $RERUN"; for l in $LABELS; do echo "$l=$(cmd_of "$l")"; done; } | git hash-object --stdin)"
  if [ -f "$D/pid" ] && [ ! -f "$D/rc" ] && kill -0 "$(cat "$D/pid")" 2>/dev/null; then
    [ "$(cat "$D/key" 2>/dev/null)" = "$KEY" ] \
      || die "a different ck-lite-qa run for $ID is still going — ck-lite-qa wait $ID first"
    echo "ck-lite-qa: $ID is already running — waiting on that run, not starting another"
  else
    rm -f "$D.lane"; rm -rf "$D"; mkdir -p "$D" || die "cannot create $D"
    echo "$KEY" >"$D/key"; date +%s >"$D/start"
    # SIGHUP ignored by hand, never nohup: under the Claude Code sandbox nohup cannot detach (exit 127)
    set -- bash -c 'trap "" HUP; "$0" __worker "$@" >"$D/out" 2>&1; echo $? >"$D/rc.tmp"; mv "$D/rc.tmp" "$D/rc"' "$SELF" "${ARGS[@]}"
    if qa_foreground; then
      echo $$ >"$D/pid"; D="$D" "$@" </dev/null >/dev/null 2>&1
    else
      D="$D" "$@" </dev/null >/dev/null 2>&1 &
      echo $! >"$D/pid"
    fi
  fi
  await_run "$ID"
fi

log_of() { printf '%s/ck-lite-%s-%s-%s.log' "$TMP" "$REPO" "$ID" "$1"; }

# The lessons (shared with the release script) whose error regex matches the end of failed
# log $1: a fix already found in another project. Silent when nothing matches.
LESSONS_FILE="${CK_LESSONS:-$HOME/.claude/ck-lessons.md}"
lessons_for() {
  local text line re
  [ -f "$LESSONS_FILE" ] || return 0
  text="$(tail -n 200 "$1" 2>/dev/null)"
  grep '^- ' "$LESSONS_FILE" | while IFS= read -r line; do
    re="$(printf '%s\n' "$line" | awk -F' :: ' '{print $2}')"
    [ -n "$re" ] || continue
    printf '%s\n' "$text" | grep -Eiq -- "$re" 2>/dev/null && printf 'lesson: %s\n' "${line#- }"
  done
}

S0="$(state)"
RESULT=""   # "<label>:<PASS|FAIL|REUSED|SKIPPED>" words

run_one() {  # label → writes the exit code to <log>.rc
  local l="$1" log; log="$(log_of "$l")"
  run_capped "$(cmd_of "$l")" "$log"
  echo $? >"$log.rc"
}

TORUN=""
for l in $LABELS; do
  if [ "$REUSE" = 1 ] && [ -n "$S0" ] && [ -f "$STAMPS/$(stamp_of "$S0" "$(full_of "$l")")" ]; then
    RESULT="$RESULT $l:REUSED"
  else
    TORUN="$TORUN $l"
  fi
done

# A reused command needs no CPU; anything that runs waits for a slot first.
if [ -n "$TORUN" ]; then
  trap slot_free EXIT
  slot_take "${D:+$D/queued}"
  dk_mark
fi

if [ "$PARALLEL" = 1 ]; then
  for l in $TORUN; do run_one "$l" & done
  wait
else
  stop=0
  for l in $TORUN; do
    if [ "$stop" = 1 ]; then rm -f "$(log_of "$l").rc"; continue; fi
    run_one "$l"
    [ "$(cat "$(log_of "$l").rc")" = 0 ] || stop=1
  done
fi

DK_OUT="$(dk_sweep "$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)")"
S1="$(state)"
[ "$S0" = "$S1" ] || echo "ck-lite-qa: WARN — a command changed the working tree (formatter, snapshot update?); nothing stamped, fix that before trusting a PASS"

SNAP=""; [ -n "$S0" ] && [ "$S0" = "$S1" ] && SNAP="$(snapshot "$S0")"
FAILED=""
for l in $TORUN; do
  rc_file="$(log_of "$l").rc"
  if [ ! -f "$rc_file" ]; then RESULT="$RESULT $l:SKIPPED"; continue; fi
  rc="$(cat "$rc_file")"; rm -f "$rc_file"
  [ -z "$RES_TO" ] || echo "$rc" >"$(log_of "$l").code"
  [ -n "$SNAP" ] && printf '%s\n%s\n%s\n' "$SNAP" "$(pwd -P)" "$(full_of "$l")" >"$(last_of "$ID" "$l")"
  if [ "$rc" = 0 ]; then
    RESULT="$RESULT $l:PASS"
    [ -n "$SNAP" ] && : >"$STAMPS/$(stamp_of "$S0" "$(full_of "$l")")"
  else
    v=FAIL; [ ! -f "$(log_of "$l").timeout" ] || v=TIMEOUT
    rm -f "$(log_of "$l").timeout"
    RESULT="$RESULT $l:$v"; FAILED="$FAILED $l"
  fi
done
# the lane reads each label's verdict here, never from text a command could have printed
if [ -n "$RES_TO" ]; then
  for r in $RESULT; do
    l="${r%%:*}"; rc="$(cat "$(log_of "$l").code" 2>/dev/null)"
    printf '%s %s %s\n' "${r#*:}" "${rc:-0}" "$(log_of "$l")" >"$RES_TO-$l"
  done
fi

[ -z "$DK_OUT" ] || echo "$DK_OUT"
[ "$SLOT_WAITED" -lt 1 ] || echo "ck-lite-qa: waited ${SLOT_WAITED}s for a CPU slot ($CPU_SLOTS on this machine, CK_QA_SLOTS)$( [ "$SLOT_IDLE" = 0 ] || echo "; started beside them on a half-idle machine")"
for r in $RESULT; do
  l="${r%%:*}"; v="${r#*:}"
  case "$v" in
    REUSED)  echo "$l: REUSED — already passed on this code state here" ;;
    SKIPPED) echo "$l: SKIPPED — an earlier command failed" ;;
    PASS)    if [ "$RERUN" = 1 ]; then
               echo "$l: PASS (re-run) — stamped as the full command; log $(log_of "$l")"
             else
               echo "$l: PASS — log $(log_of "$l")"
             fi ;;
    TIMEOUT) echo "$l: FAIL — timed out after ${QA_TIMEOUT}s (CK_QA_TIMEOUT) and was stopped, its processes with it; log $(log_of "$l")" ;;
    *)       echo "$l: $v — log $(log_of "$l")" ;;
  esac
done
for l in $FAILED; do
  echo "--- $l (last 40 lines of $(log_of "$l")) ---"
  tail -n 40 "$(log_of "$l")"
done
LESSON_OUT="$(for l in $FAILED; do lessons_for "$(log_of "$l")"; done | awk '!seen[$0]++' | head -n 3)"
[ -z "$LESSON_OUT" ] || { echo "--- known fixes from $LESSONS_FILE (try them first) ---"; echo "$LESSON_OUT"; }

if [ -n "$FAILED" ]; then echo "ck-lite-qa: FAIL —${FAILED}"; exit 1; fi
echo "ck-lite-qa: PASS"
