#!/usr/bin/env bash
# ck-lite-bootstrap — commit the "ck-code-lite is required here" guard into this project.
#
# A ck-code-lite project keeps its plan in tasks/PLAN.md, and every write to it goes through
# the plugin's ck-lite. Where the plugin is missing, nothing in it can say so — so the
# guarantee lives in the REPO, as two committed things:
#
#   .claude/ck-code-lite-required.sh   a SessionStart hook that fires on any clone
#   .claude/settings.json              wires it, opts the project into the plugin and names
#                                      where ck-marketplace lives
#
# On a machine with the plugin the guard is silent. Without it, locally it asks for the
# install; in a cloud session (CLAUDE_CODE_REMOTE=true), which never installs the plugins a
# repo enables, it installs the plugin itself and asks for /reload-plugins.
#
# Usage: ck-lite-bootstrap install [--quiet] | check
#   --quiet prints only when something was written. Exit 0 ok, 1 not written, 2 usage.
# Settings are merged with python3; without it the lines to merge by hand are printed.
set -u

GUARD_VERSION=1
GUARD_REL=".claude/ck-code-lite-required.sh"
SETTINGS_REL=".claude/settings.json"
GUARD_CMD='"$CLAUDE_PROJECT_DIR"/.claude/ck-code-lite-required.sh'

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=$PWD
GUARD="$ROOT/$GUARD_REL"
SETTINGS="$ROOT/$SETTINGS_REL"
QUIET=""

say() { [ -n "$QUIET" ] || printf '%s\n' "$1"; }

# Written verbatim into the project. The emitted additionalContext is spliced into a JSON
# string with no escaping pass: keep it free of double quotes and backslashes.
emit_guard() {
  printf '#!/usr/bin/env bash\n# ck-code-lite guard — AUTO-GENERATED by ck-lite-bootstrap. DO NOT EDIT BY HAND.\n# ck-code-lite-guard: %s\n' "$GUARD_VERSION"
  cat <<'EOF'
#
# Committed with the repo so it runs on any clone. Best-effort: never fails, never blocks,
# emits one JSON line or nothing.
cd "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null || exit 0
[ -f tasks/PLAN.md ] || exit 0

CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
command -v ck-lite >/dev/null 2>&1 && exit 0
for p in "$CFG"/plugins/cache/*/ck-code-lite/*/.claude-plugin/plugin.json; do
  [ -f "$p" ] && exit 0
done
grep -q '"ck-code-lite@' "$CFG/plugins/installed_plugins.json" 2>/dev/null && exit 0

say() { printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$1"; }
STOP='STOP before doing anything else here: do not plan, implement, commit or edit tasks/PLAN.md, and never improvise a stand-in for a /ck-code-lite:* command.'

# A cloud session never installs the plugins a repo enables, and has no machine of the
# user's to install it on — so the guard does, and /reload-plugins makes it live.
if [ "${CLAUDE_CODE_REMOTE:-}" = true ] && command -v claude >/dev/null 2>&1; then
  claude plugin marketplace add ckandrinirina/ck-code >/dev/null 2>&1
  if claude plugin install ck-code-lite@ck-marketplace --scope user >/dev/null 2>&1; then
    say "ck-code-lite was just installed into this cloud session by the repo guard (.claude/ck-code-lite-required.sh), but its /ck-code-lite:* commands load only after a plugin reload. $STOP Ask the user to type /reload-plugins (or start a new session), then carry on with their request."
  else
    say "⛔ ck-code-lite is REQUIRED in this project and installing it into this cloud session failed. $STOP Tell the user: the cloud environment needs network access to github.com (the default Trusted level allows it); then run claude plugin install ck-code-lite@ck-marketplace in this session, or continue locally, over SSH, or with Remote Control, where installed plugins load."
  fi
  exit 0
fi

say "⛔ ck-code-lite is REQUIRED in this project and is not installed. This repo keeps its plan in tasks/PLAN.md, and every write to it goes through the plugin. $STOP Give the user these commands and wait: /plugin marketplace add ckandrinirina/ck-code — then /plugin install ck-code-lite@ck-marketplace — then /reload-plugins."
EOF
}

installed_version() { awk '/^# ck-code-lite-guard:/{print $3; exit}' "$GUARD" 2>/dev/null; }

# Prints the settings keys it added, nothing when all three were already there.
settings_write() {
  if ! command -v python3 >/dev/null 2>&1; then
    printf '  ! python3 not found — merge this into %s by hand:\n' "$SETTINGS_REL"
    printf '    "enabledPlugins": { "ck-code-lite@ck-marketplace": true },\n'
    printf '    "extraKnownMarketplaces": { "ck-marketplace": { "source": { "source": "github", "repo": "ckandrinirina/ck-code" } } },\n'
    printf '    "hooks": { "SessionStart": [ { "hooks": [ { "type": "command", "command": "%s" } ] } ] }\n' "$GUARD_CMD"
    return 1
  fi
  SETTINGS="$SETTINGS" GUARD_CMD="$GUARD_CMD" python3 -I - <<'PY'
import json, os, sys
path, guard = os.environ['SETTINGS'], os.environ['GUARD_CMD']
data = {}
if os.path.exists(path):
    try:
        with open(path, encoding='utf-8') as fh:
            data = json.load(fh)
    except Exception as exc:
        print('  ! %s is not valid JSON (%s) — left untouched' % (path, exc)); sys.exit(1)
    if not isinstance(data, dict):
        print('  ! %s is not a JSON object — left untouched' % path); sys.exit(1)
changed = []
ep = data.get('enabledPlugins') if isinstance(data.get('enabledPlugins'), dict) else {}
if 'ck-code-lite@ck-marketplace' not in ep:          # an explicit false is the user's call
    ep['ck-code-lite@ck-marketplace'] = True; changed.append('enabledPlugins')
data['enabledPlugins'] = ep
mk = data.get('extraKnownMarketplaces') if isinstance(data.get('extraKnownMarketplaces'), dict) else {}
if 'ck-marketplace' not in mk:
    mk['ck-marketplace'] = {'source': {'source': 'github', 'repo': 'ckandrinirina/ck-code'}}
    changed.append('extraKnownMarketplaces')
data['extraKnownMarketplaces'] = mk
hooks = data.get('hooks') if isinstance(data.get('hooks'), dict) else {}
starts = hooks.get('SessionStart') if isinstance(hooks.get('SessionStart'), list) else []
wired = any('ck-code-lite-required.sh' in str(h.get('command', ''))
            for e in starts if isinstance(e, dict)
            for h in (e.get('hooks') or []) if isinstance(h, dict))
if not wired:
    starts.append({'hooks': [{'type': 'command', 'command': guard}]}); changed.append('SessionStart hook')
hooks['SessionStart'] = starts
data['hooks'] = hooks
if changed:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False); fh.write('\n')
    print(', '.join(changed))
PY
}

cmd_install() {
  local had wrote="" keys
  [ -f "$ROOT/tasks/PLAN.md" ] || { say "guard: no tasks/PLAN.md — not a ck-code-lite project, nothing written"; return 0; }
  # A cloned repo could commit these paths as symlinks; following one would overwrite a file
  # outside the project.
  if [ -L "$ROOT/.claude" ] || [ -L "$GUARD" ] || [ -L "$SETTINGS" ]; then
    printf '  ! .claude, %s or %s is a symlink — nothing written\n' "$GUARD_REL" "$SETTINGS_REL" >&2; return 1
  fi
  had=$(installed_version)
  if [ "$had" != "$GUARD_VERSION" ]; then
    mkdir -p "$ROOT/.claude" && emit_guard > "$GUARD" && chmod +x "$GUARD" ||
      { printf '  ! could not write %s\n' "$GUARD_REL" >&2; return 1; }
    wrote="$GUARD_REL v$GUARD_VERSION"
  fi
  keys=$(settings_write) || { printf '%s\n' "$keys"; return 1; }
  [ -n "$keys" ] && wrote="${wrote:+$wrote; }$SETTINGS_REL ($keys)"
  if [ -n "$wrote" ]; then
    printf 'guard: wrote %s — commit them, so a clone, a cloud session or a teammate without ck-code-lite gets it installed\n' "$wrote"
  else
    say "guard: current (v$GUARD_VERSION)"
  fi
}

cmd_check() {
  local had
  had=$(installed_version)
  if [ -z "$had" ]; then echo "guard: MISSING — run ck-lite-bootstrap install"; return 1; fi
  [ "$had" = "$GUARD_VERSION" ] || { echo "guard: v$had, current is v$GUARD_VERSION — run ck-lite-bootstrap install"; return 1; }
  grep -q 'ck-code-lite-required.sh' "$SETTINGS" 2>/dev/null || { echo "guard: not wired in $SETTINGS_REL — run ck-lite-bootstrap install"; return 1; }
  grep -q '"ck-marketplace"' "$SETTINGS" 2>/dev/null || { echo "guard: ck-marketplace not declared in $SETTINGS_REL — run ck-lite-bootstrap install"; return 1; }
  git -C "$ROOT" ls-files --error-unmatch "$GUARD_REL" >/dev/null 2>&1 ||
    { echo "guard: v$had, not committed — git add $GUARD_REL $SETTINGS_REL"; return 0; }
  echo "guard: v$had, wired and committed"
}

case "${1:-}" in
  install) shift; [ "${1:-}" = --quiet ] && QUIET=1; cmd_install ;;
  check) cmd_check ;;
  *) echo "usage: ck-lite-bootstrap install [--quiet] | check" >&2; exit 2 ;;
esac
